API_SERVER_KEY=intellita_api_key
REACT_APP_PORT=3000

# Firebase Configuration (for react_app/.env)
# Note: These should be placed in react_app/.env with VITE_ prefix
# VITE_FIREBASE_API_KEY=your_api_key_here
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# VITE_FIREBASE_APP_ID=your_app_id
# VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# RustFS/S3-Compatible Storage Configuration
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=intellita
S3_REGION=us-east-1

#AWS Configuration
#AWS_ACCESS_KEY_ID=your_access_key_id_here
#AWS_SECRET_ACCESS_KEY=your_secret_access_key_id_here
#AWS_REGION=your_aws_region_here
#AWS_S3_BUCKET=your_s3_bucket_name_here

#LLM Configuration
